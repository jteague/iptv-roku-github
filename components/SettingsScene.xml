             options changed) | "refresh" | "cancelled" -->
        <field id="action" type="string" value="" alwaysNotify="true" />
        <!-- Loaded-data summary for the About page, set by MainScene (epgInfo()) -->
        <field id="epgInfo" type="assocarray" onChange="renderAbout" />
        <!-- { channelId: streamUrl } for the codec-hidden channels that are loaded, set by
             MainScene (codecHiddenStreamUrls()); Hidden Channels > Retry plays them -->
        <field id="streamUrls" type="assocarray" />
    </interface>
